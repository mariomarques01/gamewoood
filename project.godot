config_version=5

[autoload]
GameAudio="*res://scripts/audio_director.gd"

[application]
config/name="PROJECT DEADLIGHT"
config/version="0.11.0"
config/icon="res://assets/pwa/icon-512.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[editor]
import/use_multiple_threads=false

[rendering]
lights_and_shadows/directional_shadow/size=1024
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input_devices]
pointing/emulate_mouse_from_touch=false

[input]

jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
